# Build portable Linux installers (AppImage + .deb) in Docker from macOS or Windows hosts.
# Usage (from repo root):
#   ./scripts/build-linux-docker.sh
# Artifacts land in ui/desktop/release/

FROM node:20-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    pkg-config \
    libssl-dev \
    libfuse2 \
    fakeroot \
    rpm \
    squashfs-tools \
    libarchive-tools \
    desktop-file-utils \
    xvfb \
    git \
  && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /workspace

COPY ui/desktop/package.json ui/desktop/package-lock.json ui/desktop/
RUN cd ui/desktop && npm ci

COPY . .

CMD ["bash", "-lc", "cd ui/desktop && xvfb-run --auto-servernum npm run dist"]
