{
  "name": "orc-desktop",
  "private": true,
  "version": "2.5.0",
  "description": "ORC Torrent Client - A decentralized BitTorrent client with privacy features",
  "author": "ORC Torrent / The ANIMUS PROJECT <contact@orclabs.io>",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-animus-project/Orc-Torrent.git"
  },
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npx tsx ./scripts/dev.ts",
    "build": "npx tsx ./scripts/build.ts",
    "build:daemon": "cd ../.. && cargo build --release -p orc-daemon && cd ui/desktop",
    "build:electron": "npx vite build && npx tsc -p tsconfig.main.json && npx tsc -p tsconfig.preload.json",
    "build:android-web": "npx vite build --mode android --outDir dist/android",
    "pack": "electron-builder --dir",
    "clean": "npx tsx ./scripts/clean.ts",
    "clean:deep": "npx tsx ./scripts/clean.ts --deep",
    "predist": "npx tsx ./scripts/clean.ts",
    "dist": "npx tsx ./scripts/dist.ts",
    "dist:quick": "npx tsx ./scripts/build.ts && electron-builder --dir",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"*.{json,ts}\" \"vite.config.ts\" \"splash.html\"",
    "audit:size": "tsx ./scripts/audit-size.ts",
    "lint:types": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "electron-updater": "^6.8.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^8.2.2",
    "electron": "^39.8.4",
    "electron-builder": "^26.15.3",
    "prettier": "^3.6.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.2",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "rollup": ">=4.59.0",
    "tar": ">=7.5.16",
    "lodash": ">=4.18.0",
    "minimatch": ">=10.2.3",
    "@xmldom/xmldom": "0.8.13",
    "picomatch": ">=4.0.4",
    "form-data": ">=4.0.6",
    "tmp": ">=0.2.7",
    "postcss": ">=8.5.10",
    "ip-address": ">=10.1.1",
    "js-yaml": "4.3.0",
    "@babel/core": "7.29.7",
    "esbuild": ">=0.28.1",
    "launch-editor": ">=2.14.1"
  },
  "build": {
    "appId": "com.orc.torrent",
    "productName": "ORC TORRENT",
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "assets/icons/icon.ico",
      "assets/icons/icon-512.png",
      "splash.html",
      "images/orctorrent-logo.png",
      "images/animus/**/*",
      "!**/*.map",
      "!**/*.{test,spec}.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.md",
      "!release/win-unpacked/**/*",
      "!release/linux-unpacked/**/*",
      "!release/mac*/**/*",
      "!release/**/*.exe",
      "!release/**/*.blockmap",
      "!release/**/*.yaml",
      "!release/**/*.yml",
      "!release/_temp_*/**/*",
      "!**/.cache/**",
      "!assets/bin/**/*.md"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ORC TORRENT",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "assets/icons/icon.ico",
      "protocols": [
        {
          "name": "magnet",
          "schemes": [
            "magnet"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "torrent",
          "name": "BitTorrent File",
          "description": "BitTorrent torrent file",
          "mimeType": "application/x-bittorrent",
          "icon": "assets/icons/icon.ico"
        }
      ]
    },
    "linux": {
      "artifactName": "ORC-TORRENT-${version}-${os}-${arch}.${ext}",
      "maintainer": "ORC Torrent <contact@orclabs.io>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "protocols": [
        {
          "name": "magnet",
          "schemes": [
            "magnet"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "torrent",
          "name": "BitTorrent File",
          "description": "BitTorrent torrent file",
          "mimeType": "application/x-bittorrent"
        }
      ]
    },
    "mac": {
      "icon": "assets/icons/icon-512.png",
      "artifactName": "ORC-TORRENT-${version}-${os}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip",
        "pkg"
      ],
      "protocols": [
        {
          "name": "magnet",
          "schemes": [
            "magnet"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "torrent",
          "name": "BitTorrent File",
          "description": "BitTorrent torrent file",
          "mimeType": "application/x-bittorrent"
        }
      ]
    },
    "pkg": {
      "installLocation": "/Applications",
      "scripts": "installer/macos/pkg-scripts"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ORC TORRENT",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false,
      "include": "installer/installer.nsh",
      "artifactName": "ORC-TORRENT-Setup-${version}.${ext}",
      "installerLanguages": [
        "en_US"
      ],
      "preCompressedFileExtensions": [
        "7z",
        "zip",
        "gz",
        "bz2",
        "xz",
        "lz",
        "lzma"
      ],
      "menuCategory": false,
      "differentialPackage": false
    },
    "artifactName": "ORC-TORRENT-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "extraResources": [
      {
        "from": "assets/bin",
        "to": "bin",
        "filter": [
          "**/*",
          "**/*.sha256"
        ]
      },
      {
        "from": "assets/icons/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asarUnpack": [
      "assets/bin/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "The-animus-project",
        "repo": "Orc-Torrent"
      }
    ]
  }
}
