#!/bin/sh
# Remove Cursor agent co-author trailers injected into commit messages.

msgfile="$1"
[ -f "$msgfile" ] || exit 0

tmp="${msgfile}.orc-clean"
grep -viE '^Co-authored-by:[[:space:]]*Cursor[[:space:]]*<cursoragent@cursor\.com>' "$msgfile" |
  grep -viE '^Co-authored-by:.*cursoragent@cursor\.com' >"$tmp" || true
mv "$tmp" "$msgfile"
exit 0
